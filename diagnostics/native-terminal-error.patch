+
+// Diagnostic-only: no behavior changes.
+fn tick_diagnostic(message: &str) {
+    #[cfg(target_os = "android")]
+    {
+        #[link(name = "log")]
+        unsafe extern "C" { fn __android_log_write(priority: i32, tag: *const std::ffi::c_char, text: *const std::ffi::c_char) -> i32; }
+        if let Ok(message) = std::ffi::CString::new(message) {
+            unsafe { __android_log_write(6, c"JazzTickProbe".as_ptr(), message.as_ptr()); }
+        }
+    }
+    #[cfg(not(target_os = "android"))]
+    eprintln!("[JazzTickProbe] {message}");
+}
